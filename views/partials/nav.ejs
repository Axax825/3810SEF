<% const staff = user.role !== "student"; %>
<header class="topbar<%= staff ? ' staff-sidebar' : ' student-topbar' %>">
  <a class="brand" href="/desk">Lost Desk</a>
  <nav class="topnav" aria-label="<%= staff ? 'Staff tools' : 'Lost Desk' %>">
    <% if (staff) { %>
      <a href="/desk" class="<%= title === 'User management' || title === 'Category management' ? '' : 'nav-active' %>">Items</a>
      <a href="/manage/users" <%= title === 'User management' ? 'aria-current="page"' : '' %>>Users</a>
      <a href="/manage/categories" <%= title === 'Category management' ? 'aria-current="page"' : '' %>>Categories</a>
    <% } else { %>
      <a href="/desk" <%= title === "Waiting" ? 'aria-current="page"' : "" %>>Browse items</a>
      <a href="/desk#collection">Collection desk</a>
    <% } %>
    <form class="logout" action="/logout" method="post">
      <span class="who"><%= user.displayName %></span>
      <button type="submit">Log out</button>
    </form>
  </nav>
</header>
