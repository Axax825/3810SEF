<%- include("partials/head") %>
<%- include("partials/nav") %>
<main class="wrap desk-page">
  <header class="page-head"><h1><%= title %></h1></header>
  <% if (section === "users") { %>
    <form class="management-search" method="get">
      <div class="field">
        <label for="user-search">Username or display name</label>
        <input id="user-search" name="q" value="<%= q %>" maxlength="40">
      </div>
      <button class="btn" type="submit">Search</button>
    </form>
    <% if (!rows.length) { %><p class="empty">No accounts match this search.</p><% } %>
  <% } %>
  <% if (rows.length) { %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="<%= title %> table">
      <table class="desk-table">
        <% if (section === "users") { %>
          <thead><tr><th scope="col">Username</th><th scope="col">Display name</th><th scope="col">Role</th></tr></thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr><th scope="row"><%= row.username %></th><td><%= row.displayName %></td><td><%= row.role === "student" ? "Student" : "Staff" %></td></tr>
            <% }); %>
          </tbody>
        <% } else { %>
          <thead><tr><th scope="col">Category</th><th scope="col">Items</th></tr></thead>
          <tbody>
            <% rows.forEach((row) => { %>
              <tr><th scope="row"><a href="/desk?category=<%= row.category %>"><%= categoryLabel(row.category) %></a></th><td><%= row.count %></td></tr>
            <% }); %>
          </tbody>
        <% } %>
      </table>
    </div>
  <% } %>
</main>
<%- include("partials/foot") %>
