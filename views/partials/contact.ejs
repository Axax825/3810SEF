<section class="desk-info" aria-label="Lost Desk counter">
  <article>
    <p class="eyebrow">Claim here</p>
    <h2><%= desk.place %></h2>
    <p class="meta"><%= desk.placeZh %> · <%= desk.building %></p>
    <p>Items below are at this counter, waiting for the owner.</p>
    <p class="meta"><%= desk.hours %></p>
  </article>
  <article>
    <p class="eyebrow">Found something?</p>
    <h2>Hand it in, or call us</h2>
    <p>Bring it to the activity room. If you cannot carry it, tell us where it is and the desk will pick it up and keep it.</p>
    <p><a href="tel:+85254064218"><%= desk.phone %></a></p>
    <p><a href="mailto:<%= desk.email %>"><%= desk.email %></a></p>
  </article>
</section>
